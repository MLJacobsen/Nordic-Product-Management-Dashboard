# Use / locally. The Pages workflow overrides this with the repository base path.
VITE_BASE_PATH=/

# Optional shared responsibility editing. Leave unset for the public read-only snapshot.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:3000/

# Prefer an immutable SharePoint site ID. If omitted, hostname + site path are resolved at runtime.
VITE_GRAPH_SITE_ID=
VITE_GRAPH_SHAREPOINT_HOSTNAME=storebrand.sharepoint.com
VITE_GRAPH_SITE_PATH=/sites/NordiskProdukt
VITE_GRAPH_FILE_PATH=/Felles/2 Governing Documents/Document overview.xlsx
VITE_GRAPH_WORKSHEET=Overview
VITE_GRAPH_REVALIDATE_MS=60000
