# Microsoft Entra single-page application (public identifiers; never add secrets)
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional. Defaults to the current origin plus VITE_BASE_PATH.
# VITE_ENTRA_REDIRECT_URI=http://localhost:3000/

# SharePoint workbook location
VITE_GRAPH_SHAREPOINT_HOSTNAME=storebrand.sharepoint.com
VITE_GRAPH_SITE_PATH=/sites/NordiskProdukt
VITE_GRAPH_DRIVE_NAME=Felles
# Use VITE_GRAPH_DRIVE_ID instead of VITE_GRAPH_DRIVE_NAME when preferred.
# VITE_GRAPH_DRIVE_ID=
VITE_GRAPH_FILE_PATH=/2 Governing Documents/Document overview.xlsx
VITE_GRAPH_WORKSHEET=Sheet1

# Microsoft Graph's Excel usedRange endpoint currently requires Files.ReadWrite.
VITE_GRAPH_SCOPES=Files.ReadWrite

# Use / locally. The Pages workflow overrides this with the repository base path.
VITE_BASE_PATH=/

# Development only. Vite ignores this flag in production builds.
VITE_ANNUAL_PLAN_SAMPLE_MODE=false
